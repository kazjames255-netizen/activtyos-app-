# Next.js frontend configuration — copy to .env.local and fill in from the
# Firebase console → Project settings → General → "Your apps" (web app config).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the Express API runs (server/ — defaults to port 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to 1 only when developing against the Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1

# Stripe publishable key (same Stripe account as the API's STRIPE_SECRET_KEY).
# Powers every card form: the parent pay modal, the invoice pay page and the
# subscription-billing gate. Unset = those forms don't mount and no card can
# be taken. Baked in at BUILD time, like everything NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Switches the checkout's Tax-Free Childcare step onto the real HMRC hand-off
# (GOV.UK sign-in → our API → HMRC's Payments API). Set it to 1 ONLY when the
# API has its HMRC_TFC_* credentials — the API is the authority and will tell
# the browser to fall back if it doesn't. Unset (the default) = no HMRC call is
# ever made: a simulated link, an example balance, and the parent gives us the
# payment reference by hand, which is how this has always worked.
# NEXT_PUBLIC_HMRC_TFC=1
