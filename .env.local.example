# Next.js frontend configuration — copy to .env.local and fill in from the
# Firebase console → Project settings → General → "Your apps" (web app config).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the Express API runs (server/ — defaults to port 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to 1 only when developing against the Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
