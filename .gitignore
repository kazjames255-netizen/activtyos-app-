# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.auth
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# also guard dot-less env files (e.g. a stray `server/env` copy of secrets)
/env
/server/env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server (Express backend)
server/node_modules
server/serviceAccountKey.json

# env templates are safe to commit
!.env.example
!.env.local.example
!server/.env.example
