{
  "name": "activityos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:server": "npm --prefix server run dev",
    "dev:test:api": "TEST_STACK=1 PORT=4001 npm --prefix server run start",
    "dev:test:web": "NEXT_PUBLIC_TEST_STACK=1 NEXT_DIST_DIR=.next-test NEXT_PUBLIC_API_URL=http://localhost:4001 next dev -p 3001",
    "dev:test": "concurrently -n tapi,tweb -c yellow,green \"npm run dev:test:api\" \"npm run dev:test:web\"",
    "emu:start": "node scripts/emu/run.mjs emu",
    "dev:emu:api": "node scripts/emu/run.mjs api",
    "dev:emu:web": "node scripts/emu/run.mjs web",
    "dev:emu": "node scripts/emu/run.mjs all",
    "test:testStackGuard": "server/node_modules/.bin/tsx --test tests/test-stack-guard.test.mts",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "seed": "npm --prefix server run seed",
    "hub:widgets": "node scripts/hub-widgets.mjs",
    "i18n:check": "server/node_modules/.bin/tsx scripts/i18n-missing.mjs && server/node_modules/.bin/tsx scripts/i18n-missing.mjs --selftest",
    "prebuild": "node scripts/hub-widgets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:money": "server/node_modules/.bin/tsx --test tests/money.test.mts",
    "test:cancel": "server/node_modules/.bin/tsx --test tests/cancellations.test.mts",
    "test:waitlist": "server/node_modules/.bin/tsx --test tests/waitlist-capacity.test.mts",
    "test:payments": "server/node_modules/.bin/tsx --test tests/payments-edge.test.mts",
    "test:public": "server/node_modules/.bin/tsx --test tests/public-access.test.mts",
    "test:finance": "server/node_modules/.bin/tsx --test tests/finance.test.mts",
    "test:amend": "server/node_modules/.bin/tsx --test tests/amend-passes.test.mts",
    "test:listings": "server/node_modules/.bin/tsx --test tests/listings.test.mts",
    "test:questions": "server/node_modules/.bin/tsx --test tests/child-questions.test.mts",
    "test:emails": "server/node_modules/.bin/tsx --test tests/emails.test.mts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:cleanup": "npm --prefix server run e2e-cleanup",
    "test:regression": "server/node_modules/.bin/tsx --test --test-reporter=tap tests/regression/*.test.mts",
    "test:emu": "node scripts/emu/test-emu.mjs",
    "test:all": "server/node_modules/.bin/tsx --test --test-reporter=tap tests/*.test.mts tests/regression/*.test.mts",
    "test:emu": "server/node_modules/.bin/tsx --test --test-concurrency=1 tests/emulator/*.test.mts",
    "assure": "npm run test:all && npx tsc --noEmit"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.92.2",
    "@geoman-io/leaflet-geoman-free": "^2.20.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.10.0",
    "@types/katex": "^0.16.8",
    "firebase": "^12.16.0",
    "immer": "^11.1.11",
    "jspdf": "^4.2.1",
    "katex": "^0.16.11",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
