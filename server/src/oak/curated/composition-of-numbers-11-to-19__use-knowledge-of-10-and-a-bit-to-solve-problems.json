                "16"
              ],
              "answer": 1
            },
            {
              "q": "7 + 10 = ?",
              "options": [
                "17",
                "18",
                "16"
              ],
              "answer": 0
            },
            {
              "q": "Sam has 10 acorns. Lucas has 9 acorns. How many acorns do they have?",
              "options": [
                "18",
                "20",
                "19"
              ],
              "answer": 2
            },
            {
              "q": "Lucas found 3 shells and then 10 more shells. How many shells did he find?",
              "options": [
                "13",
                "30",
                "12"
              ],
              "answer": 0
            }
          ]
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Missing part: pencils",
      "blocks": [
        {
          "t": "text",
          "text": "If we know the whole and one part, we can work out the missing part."
        },
        {
          "t": "text",
          "text": "Sam has 15 pencils. Some are hidden. She can see 10 pencils. How many are hidden?"
        },
        {
          "t": "list",
          "items": [
            "The whole is 15.",
            "One part is 10.",
            "The other part must be 5.",
            "5 are hidden because 15 is 10 and 5."
          ]
        },
        {
          "t": "callout",
          "text": "15 = 10 + 5"
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Missing part: straws",
      "blocks": [
        {
          "t": "text",
          "text": "Sam and Lucas have 18 straws. We can see 8 straws. How many are hidden?"
        },
        {
          "t": "list",
          "items": [
            "We know the whole is 18 and 8 is a part.",
            "We know 18 is 10 and 8.",
            "18 is the sum. 10 is a part and 8 is a part.",
            "So 10 straws are hidden."
          ]
        },
        {
          "t": "callout",
          "text": "? + 8 = 18. The missing part is 10."
        }
      ]
    },
    {
      "kind": "practice",
      "title": "Missing number problems",
      "blocks": [
        {
          "t": "choices",
          "q": "Find the missing part.",
          "items": [
            {
              "q": "The whole is 16. One part is 10. What is the other part?",
              "options": [
                "5",
                "6",
                "7"
              ],
              "answer": 1
            },
            {
              "q": "The whole is 19. One part is 9. What is the other part?",
              "options": [
                "10",
                "9",
                "1"
              ],
              "answer": 0
            },
            {
              "q": "10 + ? = 12",
              "options": [
                "1",
                "3",
                "2"
              ],
              "answer": 2
            },
            {
              "q": "? + 7 = 17",
              "options": [
                "10",
                "7",
                "1"
              ],
              "answer": 0
            }
          ]
        }
      ]
    },
    {
      "kind": "explain",
      "title": "More than two parts",
      "blocks": [
        {
          "t": "text",
          "text": "Numbers can be partitioned into more than two parts. Use 10 as a part."
        },
        {
          "t": "list",
          "items": [
            "Our parts are 10 and 2 and 1.",
            "2 and 1 make 3.",
            "This is the same as 10 + 3.",
            "10 + 2 + 1 = 13"
          ]
        },
        {
          "t": "text",
          "text": "Another one: 6 straws and 4 straws are equal to 10. So 6 + 4 + 2 is the same as 10 + 2, which is 12."
        }
      ]
    },
    {
      "kind": "practice",
      "title": "Match the total",
      "blocks": [
        {
          "t": "match",
          "q": "Match each equation to its total.",
          "pairs": [
            {
              "a": "10 + 3 + 2",
              "b": "15"
            },
            {
              "a": "10 + 5 + 2",
              "b": "17"
            },
            {
              "a": "10 + 4 + 4",
              "b": "18"
            },
            {
              "a": "10 + 1 + 1",
              "b": "12"
            }
          ]
        }
      ]
    },
    {
      "kind": "check",
      "title": "Check your thinking",
      "blocks": [
        {
          "t": "choice",
          "q": "What do we call the total when parts are added together?",
          "options": [
            "part",
            "sum",
            "ones"
          ],
          "answer": 1,
          "why": "The total when numbers are added together is called the sum."
        },
        {
          "t": "choice",
          "q": "Which equation shows that 14 is made of 1 ten and 4 ones?",
          "options": [
            "10 + 4 = 14",
            "10 + 1 = 14",
            "4 + 4 = 14"
          ],
          "answer": 0,
          "why": "14 is 1 ten and 4 ones, so 14 = 10 + 4."
        }
      ]
    },
    {
      "kind": "summary",
      "title": "What we learned",
      "blocks": [
        {
          "t": "list",
          "items": [
            "The teen numbers can be partitioned into ten and a bit.",
            "Problems can be shown with part-part-whole models, ten frames and equations to show the sum.",
            "The 10 and a bit can be shown in the problem."
          ]
        },
        {
          "t": "callout",
          "text": "part + part = sum"
        }
      ]
    }
  ],
