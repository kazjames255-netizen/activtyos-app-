{
  "agent": "maths-ks1",
  "slides": [
    {
      "kind": "intro",
      "title": "Today’s learning",
      "blocks": [
        {
          "t": "lead",
          "text": "I can use my knowledge of 10 and a bit to solve problems."
        },
        {
          "t": "cards",
          "items": [
            {
              "title": "Addition problems"
            },
            {
              "title": "Missing number problems"
            }
          ]
        }
      ]
    },
    {
      "kind": "intro",
      "title": "Key words",
      "blocks": [
        {
          "t": "text",
          "text": "Tap each word to see what it means."
        },
        {
          "t": "define",
          "items": [
            {
              "term": "partition",
              "def": "The act of splitting an object or value down into smaller parts."
            },
            {
              "term": "part",
              "def": "A piece or section of the whole."
            },
            {
              "term": "sum",
              "def": "The total when numbers are added together."
            }
          ]
        }
      ],
      "pics": [
        {
          "id": "part-whole-model"
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Ten and a bit",
      "blocks": [
        {
          "t": "text",
          "text": "Teen numbers can be partitioned into ten and a bit."
        },
        {
          "t": "text",
          "text": "This can be shown on a part-part-whole model. The whole is partitioned into 10 and a bit."
        },
        {
          "t": "callout",
          "text": "We can add parts together to make the whole."
        },
        {
          "t": "chips",
          "items": [
            "10 + 1 = 11"
          ]
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Part + part = sum",
      "blocks": [
        {
          "t": "text",
          "text": "Look at the equation."
        },
        {
          "t": "chips",
          "items": [
            "10",
            "+",
            "1",
            "=",
            "11"
          ]
        },
        {
          "t": "list",
          "items": [
            "10 is a part.",
            "1 is a part.",
            "11 is the sum."
          ]
        },
        {
          "t": "callout",
          "text": "The total is called the **sum**."
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Worked example: stones",
      "blocks": [
        {
          "t": "text",
          "text": "Lucas and Sam have 10 stones and 6 stones. How many stones do they have?"
        },
        {
          "t": "list",
          "items": [
            "One part is 10.",
            "One part is 6.",
            "10 + 6 = 16",
            "We have 1 ten and 6 ones. 1 ten and 6 ones is 16."
          ]
        },
        {
          "t": "reveal",
          "label": "What is the sum?",
          "text": "The sum is **16**. 16 can be partitioned into 10 and 6."
        }
      ]
    },
    {
      "kind": "explain",
      "title": "Worked example: sticks",
      "blocks": [
        {
          "t": "text",
          "text": "They have 10 sticks and 7 sticks. How many sticks do they have in total?"
        },
        {
          "t": "list",
          "items": [
            "One part is 10.",
            "One part is 7.",
            "10 + 7 = 17",
            "We have 1 ten and 7 ones. 1 ten and 7 ones is 17."
          ]
        },
        {
          "t": "reveal",
          "label": "What is the sum?",
          "text": "The sum is **17**. 17 can be partitioned into 10 and 7."
        }
      ]
    },
    {
      "kind": "practice",
      "title": "Addition problems",
      "blocks": [
        {
          "t": "choices",
          "q": "Find the sum.",
          "items": [
            {
              "q": "10 + 5 = ?",
              "options": [
                "14",
