    },
    {
      "kind": "explain",
      "title": "The [ch] sound",
      "blocks": [
        {
          "t": "text",
          "text": "[ch] is pronounced as in ‘chercher’. Read these words and say them aloud."
        },
        {
          "t": "chips",
          "items": [
            "{ch}ercher",
            "diman{ch}e",
            "{ch}at",
            "{ch}ien"
          ]
        },
        {
          "t": "cards",
          "items": [
            {
              "title": "bou{ch}e",
              "sub": "mouth"
            },
            {
              "title": "{ch}anter",
              "sub": "to sing, singing"
            }
          ]
        },
        {
          "t": "callout",
          "text": "In all these words the letters {ch} make the [ch] sound."
        }
      ]
    },
