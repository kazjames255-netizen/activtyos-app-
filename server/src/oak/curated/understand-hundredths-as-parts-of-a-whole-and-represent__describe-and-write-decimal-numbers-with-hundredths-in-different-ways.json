            }
          ]
        }
      ]
    },
    {
      "kind": "check",
      "title": "Quick check: beyond one",
      "blocks": [
        {
          "t": "choices",
          "q": "Choose the correct answer.",
          "items": [
            {
              "q": "2.08 is the same as how many hundredths?",
              "options": [
                "28",
                "208",
                "2008"
              ],
              "answer": 1
            },
            {
              "q": "1.25 is the same as how many hundredths?",
              "options": [
                "125",
