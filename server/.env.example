# Express API server configuration.
# Copy to server/.env — or export these in your shell — before `npm run dev`.

# Port the API listens on (frontend expects 4000 by default).
PORT=4000

# Comma-separated allowed CORS origins.
CORS_ORIGIN=http://localhost:3000

# Firebase Admin credentials — EITHER:
#   1. save your service-account JSON as server/serviceAccountKey.json
#      (Firebase console → Project settings → Service accounts → Generate new
#      private key), which is gitignored, OR
#   2. point this at the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Platform (HQ) super-admin — the API creates this account automatically on
# startup when both vars are set (idempotent; an existing admin's password is
# never touched). Use a TEMP password; the admin sets their own via
# "Forgot password?" on the login page after first sign-in.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change-me-please

# Transactional email (booking confirmations, payment links…). Any SMTP
# provider works — Resend, Mailgun, SendGrid, a Gmail app password, etc.
# LEAVE UNSET in development: emails then go to a throwaway Ethereal inbox
# and every send logs a clickable preview URL in the API console.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-api-key
# MAIL_FROM="APF Activity Camps <bookings@yourdomain.com>"

# Only needed when running against the Firebase emulators instead of a real
# project (no credentials required then):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-activityos

# AI assistant (the "AI assistant" view in every portal). Answers questions
# from the account's live data via Groq — key stays server-side. Unset =
# the view explains the assistant isn't configured.
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-key
# GROQ_MODEL=llama-3.3-70b-versatile
